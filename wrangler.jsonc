{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mb-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mb-proxy.ybaspinar.dev",
      "zone_name": "ybaspinar.dev",
      "custom_domain": true
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "MB_CACHE"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MB_RATE_LIMITER",
        "class_name": "MbRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MbRateLimiter"]
    }
  ]
}
