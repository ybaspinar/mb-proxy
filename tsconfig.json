{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2024"],
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts", "src/**/*.tsx"]
}